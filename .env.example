DATABASE_URL=postgresql+psycopg://pfs:pfs_local@localhost:5435/personal_finance_studio
APP_ENV=local
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# Optional production-grade encryption key for stored integration secrets.
# If omitted, the app creates an ignored local key at data/.pfs_secret.key.
PFS_SECRET_KEY=replace-with-a-long-random-secret
# Google OAuth app used by the Monzo Google Sheets connector.
# Create once in Google Cloud Console with redirect URI:
# http://127.0.0.1:8025/api/integrations/google-sheets/monzo/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Plaid connector. Use sandbox for fake institutions; use production for real
# bank testing after Plaid enables Trial/Limited Production access.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=GB
